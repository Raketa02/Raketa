{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "worktree": { "baseRef": "head" },
  "permissions": {
    "allow": [
      "Bash(make gen-api)",
      "Bash(make openapi)",
      "Bash(make check:*)",
      "Bash(make test-hooks)",
      "Bash(bash .claude/hooks/test-hooks.sh)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh release:*)"
    ],
    "deny": [
      "Read(./backend/.env)",
      "Read(./backend/.env.local)",
      "Read(./backend/.env.docker)",
      "Read(./backend/.env.prod)",
      "Read(./frontend_club/.env)",
      "Read(./frontend_club/.env.local)",
      "Read(./frontend_player/.env)",
      "Read(./frontend_player/.env.local)",
      "Read(./.secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.jks)",
      "Read(./.venv/**)",
      "Read(./pgdata/**)",
      "Read(./**/node_modules/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/enforce-ownership.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/load-app-context.sh"
          }
        ]
      }
    ]
  }
}
