# syntax=docker/dockerfile:1.6
FROM python:3.11-slim-bookworm AS requirements
WORKDIR /tmp
RUN pip install --no-cache-dir poetry==1.8.3
COPY pyproject.toml poetry.lock /tmp/
RUN poetry export -f requirements.txt --without-hashes --with dev -o /tmp/requirements.txt

FROM python:3.11-slim-bookworm AS builder
ENV PIP_NO_CACHE_DIR=1
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential libpq-dev curl wget \
    && rm -rf /var/lib/apt/lists/*
COPY --from=requirements /tmp/requirements.txt /tmp/requirements.txt
RUN pip install --prefix=/install --no-cache-dir -r /tmp/requirements.txt

# dockerize gives the dev startup script a portable `wait-for-tcp` primitive.
ENV DOCKERIZE_VERSION=v0.7.0
RUN wget -qO /tmp/dockerize.tgz \
        https://github.com/jwilder/dockerize/releases/download/${DOCKERIZE_VERSION}/dockerize-linux-amd64-${DOCKERIZE_VERSION}.tar.gz \
    && tar -xzf /tmp/dockerize.tgz -C /usr/local/bin \
    && rm /tmp/dockerize.tgz

FROM python:3.11-slim-bookworm
ENV PYTHONUNBUFFERED=1 \
    ENV=dev \
    APP_HOME=/home/app \
    PYTHONPATH=/home/app \
    PYTHONPYCACHEPREFIX=/tmp/pycache

RUN apt-get update && apt-get install -y --no-install-recommends \
        libpq5 curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system app && useradd --system --gid app --create-home --home-dir ${APP_HOME} app

COPY --from=builder /install /usr/local
COPY --from=builder /usr/local/bin/dockerize /usr/local/bin/dockerize

WORKDIR ${APP_HOME}
COPY --chown=app:app app/ ${APP_HOME}/app/
COPY --chown=app:app migrations/ ${APP_HOME}/migrations/
COPY --chown=app:app alembic.ini ${APP_HOME}/alembic.ini
COPY --chown=app:app docker/api/startup.dev.sh ${APP_HOME}/startup.sh
RUN chmod +x ${APP_HOME}/startup.sh

USER app

EXPOSE 8000 5678
CMD ["./startup.sh"]
