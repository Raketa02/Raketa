{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "worktree": { "baseRef": "head" },
  "permissions": {
    "allow": [
      "Bash(poetry run pytest:*)",
      "Bash(poetry run ruff:*)",
      "Bash(poetry run mypy:*)",
      "Bash(poetry run alembic:*)",
      "Bash(poetry install:*)",
      "Bash(poetry show:*)",
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(make format)",
      "Bash(make typecheck)",
      "Bash(make check)",
      "Bash(make openapi)",
      "Bash(make migrate)",
      "Bash(make up)",
      "Bash(make down)",
      "Bash(make logs)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.docker)",
      "Read(./.env.prod)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./.venv/**)",
      "Read(./htmlcov/**)"
    ],
    "additionalDirectories": [
      ".."
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/../.claude/hooks/enforce-ownership.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/../.claude/hooks/guard-bash.sh"
          }
        ]
      }
    ]
  }
}
