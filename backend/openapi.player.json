              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SportsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/assessments": {
      "post": {
        "tags": [
          "assessments"
        ],
        "summary": "Start an assessment and receive its opening question",
        "description": "Idempotent per player and sport. Starting a sport that already has an unfinished run returns **that** run and its outstanding question with a 200, rather than opening a second one \u2014 so a double-tapped confirm, or a retry after a lost response, costs nothing. A sport whose previous run was completed or abandoned still starts a new run, with a 201.\n\nBoth outcomes carry the same body, so a client that only routes on the step needs no branch; the status code is there for one that wants to tell the two apart.",
        "operationId": "create_assessment_api_v1_assessments_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAssessmentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "A new assessment was started; its opening question is returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssessmentStepResponse"
                }
              }
            }
          },
          "200": {
            "description": "An assessment for this sport was already in progress; its outstanding question is returned and nothing was created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssessmentStepResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/assessments/in-progress": {
      "get": {
        "tags": [
          "assessments"
        ],
        "summary": "Resume: one sport's in-progress assessment, or every sport's",
        "description": "One question \u2014 *which of this player's runs are unfinished* \u2014 asked two ways.\n\n**With `sport`,** the answer is that sport's outstanding run as an `AssessmentStepResponse`, carrying its outstanding question, or a 204 when there is none. This is the resume read, unchanged.\n\n**Without `sport`,** the answer is an `InProgressAssessmentsResponse`: every unfinished run this player holds, at most one per sport, ordered by the sport registry, and an empty list \u2014 with a 200, never a 204 or a 404 \u2014 when there are none. Each entry carries the assessment id and its sport, which is what a router needs; it carries no question, because the caller re-reads the run it routes to and the empty answer is the common one.\n\nWhich shape comes back is decided by the parameter, so a caller that always omits `sport` always sees the collection.",
        "operationId": "find_in_progress_api_v1_assessments_in_progress_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "sport",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Sport"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Sport"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/AssessmentStepResponse"
                    },
                    {
                      "$ref": "#/components/schemas/InProgressAssessmentsResponse"
                    }
                  ],
                  "title": "Response Find In Progress Api V1 Assessments In Progress Get"
                }
              }
            }
          },
          "204": {
            "description": "No assessment in progress for that sport. Only ever returned when `sport` is supplied."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/assessments/{assessment_id}": {
      "get": {
        "tags": [
          "assessments"
        ],
        "summary": "Fetch an assessment's current state \u2014 its question or its result",
        "operationId": "get_assessment_api_v1_assessments__assessment_id__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "assessment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Assessment Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssessmentStepResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/assessments/{assessment_id}/abandonment": {
      "post": {
        "tags": [
          "assessments"
        ],
        "summary": "Abandon an in-progress assessment, freeing the sport to start again",
        "operationId": "abandon_assessment_api_v1_assessments__assessment_id__abandonment_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "assessment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Assessment Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/assessments/{assessment_id}/answers": {
      "post": {
        "tags": [
          "assessments"
        ],
        "summary": "Answer the outstanding question and receive the next step",
        "operationId": "submit_answer_api_v1_assessments__assessment_id__answers_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "assessment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Assessment Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitAnswerRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssessmentStepResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ratings": {
      "get": {
        "tags": [
          "ratings"
        ],
        "summary": "The Skill ratings this player holds, one per rated sport",
        "operationId": "list_ratings_api_v1_ratings_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RatingsResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AnswerOptionResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "text": {
            "type": "string",
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "title": "AnswerOptionResponse"
      },
      "AssessmentStepResponse": {
        "properties": {
          "assessment_id": {
            "type": "string",
            "title": "Assessment Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "questions_asked": {
            "type": "integer",
            "title": "Questions Asked",
            "description": "How many of this run's questions have been answered. The outstanding `question` is **not** counted \u2014 it has been put to the player but not answered \u2014 so a question counter reads this plus one, and a fresh run reports 0. Replayed from the transcript on every read, which is what lets a resumed run report the position it is really at rather than restarting at 1. Once the run is over this is the same number `result.questions_asked` carries."
          },
          "question": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/QuestionResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ResultResponse"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "assessment_id",
          "status",
          "questions_asked"
        ],
        "title": "AssessmentStepResponse",
        "description": "The server-driven step. Exactly one of ``question`` / ``result`` is set."
      },
      "BandResponse": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "lower": {
            "type": "number",
            "title": "Lower"
          },
          "upper": {
            "type": "number",
            "title": "Upper"
          }
        },
        "type": "object",
        "required": [
          "name",
          "lower",
          "upper"
        ],
        "title": "BandResponse"
      },
      "ConfidenceReasonResponse": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key"
          },
          "sentence": {
            "type": "string",
            "title": "Sentence"
          }
        },
        "type": "object",
        "required": [
          "key",
          "sentence"
        ],
        "title": "ConfidenceReasonResponse",
        "description": "Why confidence landed where it did: a stable key and the sentence shown."
      },
      "CreateAssessmentRequest": {
        "properties": {
          "sport": {
            "$ref": "#/components/schemas/Sport"
          }
        },
        "type": "object",
        "required": [
          "sport"
        ],
        "title": "CreateAssessmentRequest"
      },
      "FactorResponse": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "direction": {
            "type": "string",
            "title": "Direction"
          },
          "level": {
            "type": "number",
            "title": "Level"
          }
        },
        "type": "object",
        "required": [
          "key",
          "label",
          "direction",
          "level"
        ],
        "title": "FactorResponse",
        "description": "One evidence category's row: what it says, and which way it pulled.\n\n``direction`` is one of ``up`` / ``down`` / ``neutral``, computed by the\nengine from that category's own evidence against the final estimate. The\nclient never derives it \u2014 a client-side arrow is a second opinion about the\narithmetic, and two clients would eventually hold two of them."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InProgressAssessmentResponse": {
        "properties": {
          "assessment_id": {
            "type": "string",
            "title": "Assessment Id"
          },
          "sport": {
            "$ref": "#/components/schemas/Sport"
          }
        },
        "type": "object",
        "required": [
          "assessment_id",
          "sport"
        ],
        "title": "InProgressAssessmentResponse",
        "description": "One unfinished run: which assessment, and which sport it is for.\n\nCarries no question, no result and no progress. A caller reading this is\ndeciding *where to send the player*; it re-reads the run it routes to, and\nthat read is the one that reproduces the outstanding question."
      },
      "InProgressAssessmentsResponse": {
        "properties": {
          "assessments": {
            "items": {
              "$ref": "#/components/schemas/InProgressAssessmentResponse"
            },
            "type": "array",
            "title": "Assessments"
          }
        },
        "type": "object",
        "required": [
          "assessments"
        ],
        "title": "InProgressAssessmentsResponse",
        "description": "Every unfinished run this player holds \u2014 empty when they hold none.\n\nEmpty is the ordinary answer for a new account and for a player who has\nfinished everything they started, so it is a 200 with an empty list rather\nthan a 404 or the singular form's 204.\n\nOrdered by the sport registry, so a caller that wants one run can take the\nfirst entry."
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest"
      },
      "LogoutRequest": {
        "properties": {
          "refresh_token": {
            "type": "string",
            "minLength": 1,
            "title": "Refresh Token"
          }
        },
        "type": "object",
        "required": [
          "refresh_token"
        ],
        "title": "LogoutRequest"
      },
      "LogoutResponse": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message",
            "default": "Logged out successfully"
          }
        },
        "type": "object",
        "title": "LogoutResponse"
      },
      "QuestionResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "tier": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tier"
          },
          "situation": {
            "type": "string",
            "title": "Situation"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "qualifier": {
            "type": "string",
            "title": "Qualifier"
          },
          "options": {
            "items": {
              "$ref": "#/components/schemas/AnswerOptionResponse"
            },
            "type": "array",
            "title": "Options"
          }
        },
        "type": "object",
        "required": [
          "id",
          "category",
          "tier",
          "situation",
          "text",
          "qualifier",
          "options"
        ],
        "title": "QuestionResponse",
        "description": "A question in reading order: category, situation, question, answers."
      },
      "RangeResponse": {
        "properties": {
          "low": {
            "type": "number",
            "title": "Low"
          },
          "high": {
            "type": "number",
            "title": "High"
          }
        },
        "type": "object",
        "required": [
          "low",
          "high"
        ],
        "title": "RangeResponse"
      },
      "RatingResponse": {
        "properties": {
          "sport": {
            "$ref": "#/components/schemas/Sport"
          },
          "mu": {
            "type": "number",
            "title": "Mu"
          },
          "sigma": {
            "type": "number",
            "title": "Sigma"
          },
          "confidence": {
            "type": "integer",
            "title": "Confidence"
          },
          "range": {
            "$ref": "#/components/schemas/RangeResponse"
          },
          "band": {
            "$ref": "#/components/schemas/BandResponse"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "engine_version": {
            "type": "string",
            "title": "Engine Version"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "sport",
          "mu",
          "sigma",
          "confidence",
          "range",
          "band",
          "status",
          "engine_version",
          "updated_at"
        ],
        "title": "RatingResponse",
        "description": "One sport's Skill rating.\n\n``mu`` and ``sigma`` are the Level and the Uncertainty \u2014 the same spelling\n``ResultResponse`` already puts on the wire for the same two numbers, so a\nclient never has to learn that the rating it was just shown and the rating it\nlater reads back are described in two vocabularies."
      },
      "RatingsResponse": {
        "properties": {
          "ratings": {
            "items": {
              "$ref": "#/components/schemas/RatingResponse"
            },
            "type": "array",
            "title": "Ratings"
          }
        },
        "type": "object",
        "required": [
          "ratings"
        ],
        "title": "RatingsResponse",
        "description": "Every sport this player is rated at \u2014 empty when they are rated at none."
      },
      "RefreshRequest": {
        "properties": {
          "refresh_token": {
            "type": "string",
            "minLength": 1,
            "title": "Refresh Token"
          }
        },
        "type": "object",
        "required": [
          "refresh_token"
        ],
        "title": "RefreshRequest"
      },
      "ResultResponse": {
        "properties": {
          "mu": {
            "type": "number",
            "title": "Mu"
          },
          "sigma": {
            "type": "number",
            "title": "Sigma"
          },
          "confidence": {
            "type": "integer",
            "title": "Confidence"
          },
          "range": {
            "$ref": "#/components/schemas/RangeResponse"
          },
          "band": {
            "$ref": "#/components/schemas/BandResponse"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "questions_asked": {
            "type": "integer",
            "title": "Questions Asked"
          },
          "engine_version": {
            "type": "string",
            "title": "Engine Version"
          },
          "calibration_priority": {
            "type": "string",
            "title": "Calibration Priority"
          },
          "confidence_reason": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ConfidenceReasonResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "factors": {
            "items": {
              "$ref": "#/components/schemas/FactorResponse"
            },
            "type": "array",
            "title": "Factors"
          },
          "uncertainty_factors": {
            "items": {
              "$ref": "#/components/schemas/UncertaintyFactorResponse"
            },
            "type": "array",
