# Copy to `.env.docker` for the docker-compose local stack. Most DB values are
# overridden by the `environment:` block in docker-compose-local.yml — this file
# holds the rest. `.env.docker` is git-ignored — never commit real secrets.
TITLE=Raketa API
DESCRIPTION=Raketa backend (docker-compose local)
VERSION=0.1.0

# APP_ENV — one of: local | development | staging | production.
# **Only `local` runs today**; see .env.example for the full profile table and
# for why selecting an unprovisioned environment fails at startup rather than
# falling back. A container on your laptop is still `local`: the name describes
# where the software runs, not whether it is containerised.
APP_ENV=local
# APP_ENV supplies DEBUG=true, LOG_LEVEL=DEBUG and LOG_JSON=false for `local`.
# Uncomment to override one.
# DEBUG=true
# LOG_LEVEL=DEBUG
# LOG_JSON=false

EVENT_DELIVERY_WORKER_ENABLED=true
EVENT_DELIVERY_POLL_INTERVAL_SECONDS=1
EVENT_DELIVERY_BATCH_SIZE=100

# SEED_CENTRE — where `make seed` centres the population, as "latitude,longitude"
# in decimal degrees. Unset, the seed is centred on London (51.51,-0.13), where
# the committed cohort (app/seeds/cohort.json) measures from. Set it to the cell
# your test devices report — the client puts the phone's own position on the
# profile at every cold start (docs/adr/0174 §6), so a seeded account signed into
# from a phone in Kraków is moved 1,400 km from a London cohort and every location
# screen goes empty. The whole population moves as one figure and every distance
# survives. It is read by the seed command only, never by the application. Then
# `make sim-location` pins the iOS simulator to the same cell. A change here
# needs a fresh store: `make down-v && make up && make seed`.
# SEED_CENTRE=50.06,19.94

# Overridden by docker-compose-local.yml; keep the values matching.
WRITER_DB_URL=postgresql+asyncpg://raketa_user:raketa_pwd@db:5432/raketa
READER_DB_URL=postgresql+asyncpg://raketa_user:raketa_pwd@db:5432/raketa
DB_SSL_MODE=disable

# Generate a real one with: openssl rand -hex 32
# Production refuses to start with the shipped default.
JWT_SECRET_KEY=change-me-local-dev-only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_SECONDS=900
REFRESH_TOKEN_EXPIRE_SECONDS=86400

# bcrypt's work factor for passwords and refresh tokens. Unset means 12,
# production's; every deployed environment refuses anything lower. Only a laptop
# may lower it — the test suite sets bcrypt's minimum, 4, for itself.
# BCRYPT_ROUNDS=12

ALLOW_ORIGINS=*
ALLOW_CREDENTIALS=true
ALLOW_METHODS=*
ALLOW_HEADERS=*

# --- photo storage (S3-compatible: MinIO locally, S3 deployed)
# Overridden by docker-compose-local.yml; keep the values matching the `minio`
# service there. Production refuses to start with the shipped secret.
#
# Two endpoints, because they are reached differently: the first is what this
# API calls over the compose network, the second is what a *phone* opens a
# presigned URL against. A physical device needs your laptop's LAN IP in the
# second one — `localhost` on a phone is the phone.
PHOTO_STORAGE_ENDPOINT_URL=http://minio:9000
PHOTO_STORAGE_PUBLIC_ENDPOINT_URL=http://localhost:9000
PHOTO_STORAGE_BUCKET=raketa-player-photos
PHOTO_STORAGE_REGION=us-east-1
PHOTO_STORAGE_ACCESS_KEY=raketa_photos
PHOTO_STORAGE_SECRET_KEY=raketa_photos_pwd
PHOTO_URL_VALID_FOR_MINUTES=5

# --- the on-court photo check (../docs/adr/0129)
#
# WHERE the checker is and HOW LONG it may take. WHAT it asks and WHERE the line sits
# are behaviour a domain test can observe and are not configurable — see
# app/modules/player_profile/domain/photos.py. Neither value below can change a verdict.
#
# A server-to-server URL: no phone and no browser ever opens it. An unreachable sidecar
# costs a photo its verdict, never a player their upload — the client fails open and
# records that it did.
PHOTO_REVIEW_ENDPOINT_URL=http://photo-review:8000
PHOTO_REVIEW_TIMEOUT_SECONDS=10

# --- scheduled jobs (docs/adr/0092)
# How OFTEN the sweep runs. How OLD a photo must be before it sweeps one is a domain
# rule and is not configurable — see app/modules/player_profile/domain/photos.py.
PHOTO_SWEEP_ENABLED=true
PHOTO_SWEEP_INTERVAL_SECONDS=21600

# --- the photo re-review backfill (docs/adr/0132)
# Which photos get re-reviewed is NOT here: it is read off the review note the object
# already carries — see app/modules/player_profile/domain/photos.py. These four say how
# often to look, how much inference one run may spend, and how far apart to space it.
# The cadence is in hours because a run walks the whole photo prefix with a HEAD per
# object; the budget and the pause are what protect one sidecar running one worker.
PHOTO_REVIEW_BACKFILL_ENABLED=true
PHOTO_REVIEW_BACKFILL_INTERVAL_SECONDS=3600
PHOTO_REVIEW_BACKFILL_BATCH_LIMIT=100
PHOTO_REVIEW_BACKFILL_PAUSE_SECONDS=1

# --- the candidate index (docs/adr/0110, docs/adr/0112)
# Two loops: the tail reader folds the event log into the index, the refresh rebuilds
# this worker's own containers from what moved. Both cadences are configuration.
# The staleness LADDER — serve under 15 min, flag to 24 h, refuse past it — is not,
# and lives in app/modules/matchmaking/domain/index_staleness.py. A refusal the
# environment could switch off is a rule that is true on a laptop and false elsewhere.
CANDIDATE_INDEX_ENABLED=true
CANDIDATE_INDEX_TAIL_INTERVAL_SECONDS=1
CANDIDATE_INDEX_REFRESH_INTERVAL_SECONDS=2
CANDIDATE_INDEX_BATCH_SIZE=500

# --- the ephemeral store (docs/adr/0093)
# Redis holds only what is allowed to be lossy — a room's live channel and who is
# typing in it — and nothing else. Every message is a durable row before anything
# is published, so losing this costs a room its liveness and costs nobody a fact.
REDIS_URL=redis://redis:6379/0

# --- trigger 4 (docs/specs/matchmaking/scale-posture.md §4)
# The index refresh recomputes it at every load. THE THRESHOLD IS NOT HERE: half
# the container's memory lives in matchmaking/domain/scale_triggers.py, because an
# environment that could widen a trigger is an environment deciding when the
# platform is in trouble.
# How many workers this container runs. Read by docker/api/startup.prod.sh to
# start them, and by trigger 4's arithmetic so the memory reading is about the
# fleet that exists rather than one somebody typed twice.
GUNICORN_WORKERS=1
