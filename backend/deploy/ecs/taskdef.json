{
  "family": "rakieta-task5",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::422661068054:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::422661068054:role/rakieta-task-role",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "api",
      "image": "__IMAGE__",
      "essential": true,
      "portMappings": [
        { "containerPort": 8000, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "APP_ENV", "value": "production" },
        { "name": "APP_HOST", "value": "0.0.0.0" },
        { "name": "APP_PORT", "value": "8000" },
        { "name": "LOG_LEVEL", "value": "INFO" },
        { "name": "LOG_JSON", "value": "true" },
        { "name": "EVENT_DELIVERY_WORKER_ENABLED", "value": "true" },
        { "name": "DB_SSL_MODE", "value": "require" },
        { "name": "JWT_ALGORITHM", "value": "HS256" },
        { "name": "ACCESS_TOKEN_EXPIRE_SECONDS", "value": "900" },
        { "name": "REFRESH_TOKEN_EXPIRE_SECONDS", "value": "86400" },
        { "name": "RUN_MIGRATIONS_ON_STARTUP", "value": "true" }
      ],
      "secrets": [
        { "name": "JWT_SECRET_KEY", "valueFrom": "arn:aws:secretsmanager:eu-central-1:422661068054:secret:rakieta/prod-MDnizO:JWT_SECRET_KEY::" },
        { "name": "WRITER_DB_URL", "valueFrom": "arn:aws:secretsmanager:eu-central-1:422661068054:secret:rakieta/prod-MDnizO:WRITER_DB_URL::" },
        { "name": "READER_DB_URL", "valueFrom": "arn:aws:secretsmanager:eu-central-1:422661068054:secret:rakieta/prod-MDnizO:READER_DB_URL::" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -fsS http://127.0.0.1:8000/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 20
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/rakieta",
          "awslogs-region": "eu-central-1",
          "awslogs-stream-prefix": "api"
        }
      },
      "readonlyRootFilesystem": false,
      "linuxParameters": {
        "initProcessEnabled": true
      }
    }
  ]
}
