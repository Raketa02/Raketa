{
  "family": "rakieta-task5",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/rakieta-task-role",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "api",
      "image": "__IMAGE__",
      "essential": true,
      "stopTimeout": 40,
      "portMappings": [
        { "containerPort": 8000, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "APP_ENV", "value": "production" },
        { "name": "APP_HOST", "value": "0.0.0.0" },
        { "name": "APP_PORT", "value": "8000" },
        { "name": "LOG_LEVEL", "value": "INFO" },
        { "name": "LOG_JSON", "value": "true" },
        { "name": "EVENT_DELIVERY_WORKER_ENABLED", "value": "true" },
        { "name": "DB_SSL_MODE", "value": "require" },
        { "name": "JWT_ALGORITHM", "value": "HS256" },
        { "name": "ACCESS_TOKEN_EXPIRE_SECONDS", "value": "900" },
        { "name": "REFRESH_TOKEN_EXPIRE_SECONDS", "value": "86400" },
        { "name": "ALLOW_ORIGINS", "value": "" },
        { "name": "PUBLIC_SITE_URL", "value": "https://<PUBLIC_SITE_DOMAIN>" },
        { "name": "CLUB_WEBSITE_URL", "value": "https://<CLUB_WEBSITE_DOMAIN>" },
        { "name": "SMTP_HOST", "value": "<SMTP_RELAY_HOST>" },
        { "name": "SMTP_PORT", "value": "587" },
        { "name": "SMTP_SECURITY", "value": "starttls" },
        { "name": "MAIL_SENDER", "value": "Rakieta <no-reply@<PUBLIC_SITE_DOMAIN>>" },
        { "name": "RUN_MIGRATIONS_ON_STARTUP", "value": "true" },
        { "name": "PAYMENTS_PROVIDER", "value": "stripe" }
      ],
      "secrets": [
        { "name": "JWT_SECRET_KEY", "valueFrom": "arn:aws:secretsmanager:eu-central-1:<AWS_ACCOUNT_ID>:secret:rakieta/prod-<SECRET_SUFFIX>:JWT_SECRET_KEY::" },
        { "name": "WRITER_DB_URL", "valueFrom": "arn:aws:secretsmanager:eu-central-1:<AWS_ACCOUNT_ID>:secret:rakieta/prod-<SECRET_SUFFIX>:WRITER_DB_URL::" },
        { "name": "READER_DB_URL", "valueFrom": "arn:aws:secretsmanager:eu-central-1:<AWS_ACCOUNT_ID>:secret:rakieta/prod-<SECRET_SUFFIX>:READER_DB_URL::" },
        { "name": "REDIS_URL", "valueFrom": "arn:aws:secretsmanager:eu-central-1:<AWS_ACCOUNT_ID>:secret:rakieta/prod-<SECRET_SUFFIX>:REDIS_URL::" },
        { "name": "PHOTO_STORAGE_SECRET_KEY", "valueFrom": "arn:aws:secretsmanager:eu-central-1:<AWS_ACCOUNT_ID>:secret:rakieta/prod-<SECRET_SUFFIX>:PHOTO_STORAGE_SECRET_KEY::" },
        { "name": "SMTP_USERNAME", "valueFrom": "arn:aws:secretsmanager:eu-central-1:<AWS_ACCOUNT_ID>:secret:rakieta/prod-<SECRET_SUFFIX>:SMTP_USERNAME::" },
        { "name": "SMTP_PASSWORD", "valueFrom": "arn:aws:secretsmanager:eu-central-1:<AWS_ACCOUNT_ID>:secret:rakieta/prod-<SECRET_SUFFIX>:SMTP_PASSWORD::" },
        { "name": "STRIPE_SECRET_KEY", "valueFrom": "arn:aws:secretsmanager:eu-central-1:<AWS_ACCOUNT_ID>:secret:rakieta/prod-<SECRET_SUFFIX>:STRIPE_SECRET_KEY::" },
        { "name": "STRIPE_PUBLISHABLE_KEY", "valueFrom": "arn:aws:secretsmanager:eu-central-1:<AWS_ACCOUNT_ID>:secret:rakieta/prod-<SECRET_SUFFIX>:STRIPE_PUBLISHABLE_KEY::" },
        { "name": "STRIPE_WEBHOOK_SECRET", "valueFrom": "arn:aws:secretsmanager:eu-central-1:<AWS_ACCOUNT_ID>:secret:rakieta/prod-<SECRET_SUFFIX>:STRIPE_WEBHOOK_SECRET::" },
        { "name": "STRIPE_CONNECT_WEBHOOK_SECRET", "valueFrom": "arn:aws:secretsmanager:eu-central-1:<AWS_ACCOUNT_ID>:secret:rakieta/prod-<SECRET_SUFFIX>:STRIPE_CONNECT_WEBHOOK_SECRET::" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -fsS http://127.0.0.1:8000/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 20
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/rakieta",
          "awslogs-region": "eu-central-1",
          "awslogs-stream-prefix": "api"
        }
      },
      "readonlyRootFilesystem": false,
      "linuxParameters": {
        "initProcessEnabled": true
      }
    }
  ]
}
