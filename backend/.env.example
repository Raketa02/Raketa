# Copy to `.env` — that is the filename `app/core/config.py` actually loads
# (`SettingsConfigDict(env_file=".env")`). Only needed when running the API
# directly on your machine (uvicorn, no docker); `make up` needs none of this,
# because docker-compose-local.yml supplies the values itself.
#
#   cd backend && cp .env.example .env
#
# `.env` is git-ignored — never commit real secrets.
#
# The DB URLs below point at the Postgres that `make up` starts, so a host-run
# uvicorn talks to the same database as the container. Keep them in step with
# the POSTGRES_* values in docker-compose-local.yml.
TITLE=Raketa API
DESCRIPTION=Raketa backend (local)
VERSION=0.1.0

# APP_ENV — one of: local | development | staging | production
#
# **Only `local` runs today.** `development` and `staging` are defined and
# validated but not provisioned: no domain is registered, so no host and no
# database exist for either. Selecting one without setting APP_HOST and
# WRITER_DB_URL is a startup failure naming the missing variable — deliberately,
# rather than a silent fallback to the values below, which would point at a
# database that is not there.
#
# APP_ENV also supplies the defaults for DEBUG, LOG_LEVEL and LOG_JSON:
#
#   local        DEBUG=true   LOG_LEVEL=DEBUG  LOG_JSON=false
#   development  DEBUG=false  LOG_LEVEL=DEBUG  LOG_JSON=true
#   staging      DEBUG=false  LOG_LEVEL=INFO   LOG_JSON=true
#   production   DEBUG=false  LOG_LEVEL=INFO   LOG_JSON=true
#
# Each stays overridable — set one explicitly below and it wins. The three lines
# are left commented out here because `local` already derives exactly them.
APP_ENV=local
# DEBUG=true
# LOG_LEVEL=DEBUG
# LOG_JSON=false
APP_HOST=127.0.0.1
APP_PORT=8000

# READER_DB_URL defaults to the writer URL when unset.
WRITER_DB_URL=postgresql+asyncpg://raketa_user:raketa_pwd@localhost:5432/raketa
READER_DB_URL=postgresql+asyncpg://raketa_user:raketa_pwd@localhost:5432/raketa
DB_SSL_MODE=disable

# Generate a real one with: openssl rand -hex 32
# Production refuses to start with the shipped default.
JWT_SECRET_KEY=change-me-local-dev-only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_SECONDS=900
REFRESH_TOKEN_EXPIRE_SECONDS=86400

# bcrypt's work factor for passwords and refresh tokens. Unset means 12,
# production's; every deployed environment refuses anything lower. Only a laptop
# may lower it — the test suite sets bcrypt's minimum, 4, for itself.
# BCRYPT_ROUNDS=12

# Local origins: the club web app and the Expo dev server. A wildcard combined
# with credentials refuses to start in production; on a laptop it is fine.
#
# In a DEPLOYED environment every listed origin must be https:// — these are browser
# origins reached over a public network, and an http:// one there means the club
# console's session cookie travels in the clear. The wildcard is exempt from that
# rule (it is not an origin) and `local` is exempt entirely, which is why
# http://localhost:3000 is legal here. See ../docs/environments.md.
ALLOW_ORIGINS=*
ALLOW_CREDENTIALS=true
ALLOW_METHODS=*
ALLOW_HEADERS=*

# --- photo storage (S3-compatible: MinIO locally, S3 deployed — ../docs/adr/0091)
# Running uvicorn on the host: MinIO is published on localhost by `make up`, so
# both endpoints are the same address here. Inside the compose stack they differ
# — the docker template says how and why.
#
# In a DEPLOYED environment both are left **unset**, so botocore resolves AWS's
# own https endpoints. That is the whole of the adapter swap: no code changes,
# and no user data moves. Production refuses to start with the secret below,
# which is the local MinIO container's and is published in this repository.
#
# PHOTO_STORAGE_ENDPOINT_URL is a server-to-server URL and carries no scheme
# rule; PHOTO_STORAGE_PUBLIC_ENDPOINT_URL is the one a device opens. See
# ../docs/environments.md for the distinction.
PHOTO_STORAGE_ENDPOINT_URL=http://localhost:9000
PHOTO_STORAGE_PUBLIC_ENDPOINT_URL=http://localhost:9000
PHOTO_STORAGE_BUCKET=raketa-player-photos
PHOTO_STORAGE_REGION=us-east-1
PHOTO_STORAGE_ACCESS_KEY=raketa_photos
PHOTO_STORAGE_SECRET_KEY=raketa_photos_pwd
# How long a signed photo URL works for, in whole minutes.
PHOTO_URL_VALID_FOR_MINUTES=5

# --- the on-court photo check (../docs/adr/0129)
#
# WHERE the checker is and HOW LONG it may take. WHAT it asks and WHERE the line sits
# are behaviour a domain test can observe and are not configurable — see
# app/modules/player_profile/domain/photos.py. Neither value below can change a verdict.
#
# A server-to-server URL: no phone and no browser ever opens it. An unreachable sidecar
# costs a photo its verdict, never a player their upload — the client fails open and
# records that it did.
PHOTO_REVIEW_ENDPOINT_URL=http://localhost:8100
PHOTO_REVIEW_TIMEOUT_SECONDS=10

# --- scheduled jobs (docs/adr/0092)
# How OFTEN the sweep runs. How OLD a photo must be before it sweeps one is a domain
# rule and is not configurable — see app/modules/player_profile/domain/photos.py.
PHOTO_SWEEP_ENABLED=true
PHOTO_SWEEP_INTERVAL_SECONDS=21600

# --- the photo re-review backfill (docs/adr/0132)
# Which photos get re-reviewed is NOT here: it is read off the review note the object
# already carries — see app/modules/player_profile/domain/photos.py. These four say how
# often to look, how much inference one run may spend, and how far apart to space it.
# The cadence is in hours because a run walks the whole photo prefix with a HEAD per
# object; the budget and the pause are what protect one sidecar running one worker.
PHOTO_REVIEW_BACKFILL_ENABLED=true
PHOTO_REVIEW_BACKFILL_INTERVAL_SECONDS=3600
PHOTO_REVIEW_BACKFILL_BATCH_LIMIT=100
PHOTO_REVIEW_BACKFILL_PAUSE_SECONDS=1

# --- the candidate index (docs/adr/0110, docs/adr/0112)
# Two loops: the tail reader folds the event log into the index, the refresh rebuilds
# this worker's own containers from what moved. Both cadences are configuration.
# The staleness LADDER — serve under 15 min, flag to 24 h, refuse past it — is not,
# and lives in app/modules/matchmaking/domain/index_staleness.py. A refusal the
# environment could switch off is a rule that is true on a laptop and false elsewhere.
CANDIDATE_INDEX_ENABLED=true
CANDIDATE_INDEX_TAIL_INTERVAL_SECONDS=1
CANDIDATE_INDEX_REFRESH_INTERVAL_SECONDS=2
CANDIDATE_INDEX_BATCH_SIZE=500

# --- the ephemeral store (docs/adr/0093)
# Redis holds the two ledgers that are allowed to be lossy — exposure and
# suppression — and nothing else. THE GATE IS THE CACHE; THE EVIDENCE IS THE ROW:
# anything that must survive is a durable row elsewhere, so losing this costs a
# search its spread and a deck its memory, and costs nobody a fact. Both ledgers
# fail soft, so an unreachable store never excludes anybody and never empties a
# surface.
# Neither TTL is here. How long a suppression lasts is PASS_SUPPRESS, in the
# released ruleset; how long a week of exposure survives is
# EXPOSURE_RETENTION_WEEKS, in app/modules/matchmaking/domain/ledgers.py. Both
# decide what can still be asked, which makes them domain and not configuration.
REDIS_URL=redis://localhost:6379/0

# --- the exposure roll (docs/adr/0092)
# Hourly. It publishes one scalar per sport per week — what "shown more often than
# most" means — because a percentile over a week of appearances is not something a
# search can afford to compute. It opens no bucket and closes no window: the week
# is derived from now, and the previous one expires on its own.
EXPOSURE_ROLL_ENABLED=true
EXPOSURE_ROLL_INTERVAL_SECONDS=3600

# --- the interest expiry sweep (docs/adr/0092, docs/adr/0127)
# Hourly. It removes every *Let's play* whose twenty-one days have passed.
# CORRECTNESS DOES NOT DEPEND ON IT: every read of the interest ledger is bounded
# by now, so a lapsed yes lifts nobody and counts against nobody's cap whether or
# not it has been swept. What it buys is a table the size of what is live, plus
# the one figure a lapsed row could ever be asked for — yeses that expired having
# never lifted anybody, which is INTEREST_TTL's only day-one falsifier and cannot
# be computed once the rows are gone.
# INTEREST_TTL itself is NOT here. How long a yes lives decides who is admitted
# below the quality floor, which makes it a rule a domain test observes; it is a
# row in the released ruleset, as is OUTSTANDING_INTEREST_CAP.
INTEREST_EXPIRY_ENABLED=true
INTEREST_EXPIRY_INTERVAL_SECONDS=3600

# --- the challenge lapse loop (docs/adr/0092)
# Hourly. It writes down every answer window that passed with nothing in it.
# CORRECTNESS DOES NOT DEPEND ON IT: a seat past its day already reads as lapsed,
# its pair already releases and its challenge already stands as LAPSED, because a
# standing is folded from the seats and the clock and stored nowhere. What it buys
# is the RECORD — a SeatLapsed in the log, so that "answers challenges" has a
# denominator and a lapse is a fact somebody can count rather than an absence they
# have to infer. What it appends is never a decline: silence is not a judgement.
# ANSWER_WINDOW itself is NOT here. The day an invitee gets is the promise the
# invitation makes — moving it moves what every outstanding challenge already
# said — and it lives in challenges/domain/answer_window.py.
CHALLENGE_LAPSE_ENABLED=true
CHALLENGE_LAPSE_INTERVAL_SECONDS=3600

# --- the hour loop (docs/adr/0175 §3)
# A game court still short of a player when its agreed hour passes is called off
# by the platform — nobody presses Call it off any more, and this is the exit
# that is nobody's decision. Correctness depends on it: until it runs the row
# reads "needs a player" with nothing to press, so the interval is the length of
# that dead minute.
UNFILLED_COURT_ENABLED=true
UNFILLED_COURT_INTERVAL_SECONDS=60

# --- the rating catch-up (docs/adr/0139)
# The only loop here that correctness depends on. Nothing announces that a result
# was confirmed — a confirmation is a clock passing — so this is the whole path a
# confirmed counted result has to a Level. Turn it off and every rating on the
# platform quietly stops being tested, which looks exactly like a platform where
# nobody has played.
# The interval is how late the run is, never what it says: a move is stamped with
# the moment the result became final rather than with the moment the run noticed.
# The RULE is emphatically NOT here. What a result does to a Level lives in
# engines/racketskill/results.py — an environment that could pick a K-factor is an
# environment that decides how a marketplace rates people.
RATING_CATCH_UP_ENABLED=true
RATING_CATCH_UP_INTERVAL_SECONDS=3600

# --- the conversation sweep (docs/adr/0153, docs/adr/0142)
# Destroyed, not delisted. A room lasts as long as the episode it was opened for
# — arrange the game, play it, find out what happened — and is then destroyed
# rather than hidden. Turning this off changes no rule a domain test could
# observe: the end is a fold over the room's own stream, so every route already
# answers conversation_not_found past it and every list has already dropped it.
# What stops is the destruction being real, which is the whole difference between
# a room that is over and a record with no end.
# CONVERSATION_GRACE IS NOT HERE. How long a room outlives the game it was opened
# for lives in conversations/domain/lifetime.py — an environment that could
# select it is an environment deciding how long two people keep each other.
CONVERSATION_SWEEP_ENABLED=true
CONVERSATION_SWEEP_INTERVAL_SECONDS=3600

# --- the two scale triggers (docs/adr/0092, docs/specs/matchmaking/scale-posture.md §4)
# A trigger that requires somebody to go and measure fires late, so both ship
# instrumented. The probe measures its own oversleep — how much later than the
# interval below the event loop got back to it — and closes the fifteen-minute
# window trigger 1 is stated over, writing one structured log record per window.
# THE THRESHOLDS ARE NOT HERE. p99 above 20 ms, duty cycle above 0.25 and half
# the container's memory are the numbers the escalation ladder is climbed on,
# and they live in matchmaking/domain/scale_triggers.py: an environment that
# could widen a trigger is an environment deciding when the platform is in
# trouble. Turning the probe off changes nothing a domain test could observe —
# no answer moves; what stops is the record.
SCALE_PRESSURE_ENABLED=true
SCALE_PRESSURE_INTERVAL_SECONDS=1

# How many workers this container runs. Read by docker/api/startup.prod.sh to
# start them, and by trigger 4's arithmetic so the memory reading is about the
# fleet that exists rather than one somebody typed twice.
GUNICORN_WORKERS=1

# SEED_CENTRE — where the seed centres its population, as "latitude,longitude" in
# decimal degrees; unset, London (51.51,-0.13), where the committed cohort
# (app/seeds/cohort.json) measures from. The client puts the phone's own position
# on the profile at every cold start (docs/adr/0174 §6), so a seeded account
# signed into from a phone in Kraków is moved 1,400 km from a London cohort and
# every location screen goes empty; seeding around the devices instead makes that
# write a same-cell no-op. The whole population moves as one figure and every
# distance survives. **Not a line in this file**: this file is what Settings loads
# and the seed's centre is the seed command's argument, read from the shell —
# `SEED_CENTRE=50.06,19.94 make seed-host`; the docker stack takes it from
# .env.docker. `make sim-location` then pins the iOS simulator to the same cell.
# A change needs a fresh store: `make down-v && make up && make seed`.
