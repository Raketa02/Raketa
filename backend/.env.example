# Copy to `.env` — that is the filename `app/core/config.py` actually loads
# (`SettingsConfigDict(env_file=".env")`). Only needed when running the API
# directly on your machine (uvicorn, no docker); `make up` needs none of this,
# because docker-compose-local.yml supplies the values itself.
#
#   cd backend && cp .env.example .env
#
# `.env` is git-ignored — never commit real secrets.
#
# The DB URLs below point at the Postgres that `make up` starts, so a host-run
# uvicorn talks to the same database as the container. Keep them in step with
# the POSTGRES_* values in docker-compose-local.yml.
TITLE=Rakieta API
DESCRIPTION=Rakieta backend (local)
VERSION=0.1.0

# APP_ENV — one of: local | development | staging | production
#
# **Only `local` runs today.** `development` and `staging` are defined and
# validated but not provisioned: no domain is registered, so no host and no
# database exist for either. Selecting one without setting APP_HOST and
# WRITER_DB_URL is a startup failure naming the missing variable — deliberately,
# rather than a silent fallback to the values below, which would point at a
# database that is not there.
#
# APP_ENV also supplies the defaults for DEBUG, LOG_LEVEL and LOG_JSON:
#
#   local        DEBUG=true   LOG_LEVEL=DEBUG  LOG_JSON=false
#   development  DEBUG=false  LOG_LEVEL=DEBUG  LOG_JSON=true
#   staging      DEBUG=false  LOG_LEVEL=INFO   LOG_JSON=true
#   production   DEBUG=false  LOG_LEVEL=INFO   LOG_JSON=true
#
# Each stays overridable — set one explicitly below and it wins. The three lines
# are left commented out here because `local` already derives exactly them.
APP_ENV=local
# DEBUG=true
# LOG_LEVEL=DEBUG
# LOG_JSON=false
APP_HOST=127.0.0.1
APP_PORT=8000

# READER_DB_URL defaults to the writer URL when unset.
WRITER_DB_URL=postgresql+asyncpg://rakieta_user:rakieta_pwd@localhost:5432/rakieta
READER_DB_URL=postgresql+asyncpg://rakieta_user:rakieta_pwd@localhost:5432/rakieta
DB_SSL_MODE=disable

# Generate a real one with: openssl rand -hex 32
# Production refuses to start with the shipped default.
JWT_SECRET_KEY=change-me-local-dev-only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_SECONDS=900
REFRESH_TOKEN_EXPIRE_SECONDS=86400

# Local origins: the club web app and the Expo dev server. A wildcard combined
# with credentials refuses to start in production; on a laptop it is fine.
ALLOW_ORIGINS=*
ALLOW_CREDENTIALS=true
ALLOW_METHODS=*
ALLOW_HEADERS=*
