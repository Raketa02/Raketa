# sandbuket passes these through into the sandbox (copy to .sandbuket/.env).
# .env is gitignored - never commit real tokens. Keep THIS file blank.

# Authenticate Claude Code with your Claude subscription. Generate with:
#   claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# GitHub token so the agent can read/close/comment issues with `gh` inside the
# sandbox. A fine-grained PAT with repo issues read/write is enough.
GH_TOKEN=
