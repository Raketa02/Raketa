# Copy to `.env.local`. Never commit `.env.local`.
#
# SERVER-ONLY. Read by BFF route handlers (src/app/api/*) and Server Components.
# It is deliberately NOT prefixed NEXT_PUBLIC_ — the browser must never learn the
# FastAPI origin, and must never call it directly. See docs/adr/0007.
BACKEND_API_URL=http://localhost:8000

# Cookie/session settings for the BFF-managed httpOnly session.
SESSION_COOKIE_NAME=rakieta_club_session
# Set to `true` in any deployed environment (requires HTTPS).
SESSION_COOKIE_SECURE=false

# Safe to expose — this is the club app's own public origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000
