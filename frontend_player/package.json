{
  "name": "@raketa/frontend-player",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "Raketa player app — React Native + Expo. Players find courts, book slots and organise matches.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:boundaries": "bash scripts/test-import-boundaries.sh",
    "test:labels": "bash scripts/test-play-label-rule.sh",
    "gen:api": "openapi-typescript ../backend/openapi.player.json -o src/generated/schema.d.ts",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm test:boundaries && pnpm test:labels",
    "doctor": "npx expo-doctor",
    "prebuild": "expo prebuild"
  },
  "dependencies": {
    "@expo-google-fonts/archivo": "^0.2.3",
    "@expo-google-fonts/ibm-plex-mono": "^0.2.3",
    "@expo/vector-icons": "~14.0.4",
    "@tanstack/react-query": "^5.62.0",
    "expo": "~52.0.0",
    "expo-constants": "~17.0.0",
    "expo-font": "~13.0.0",
    "expo-haptics": "~14.0.1",
    "expo-image-picker": "~16.0.6",
    "expo-linking": "~7.0.0",
    "expo-location": "~18.0.10",
    "expo-network": "~7.0.5",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-splash-screen": "~0.29.0",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-sse": "^1.2.1",
    "react-native-svg": "15.8.0",
    "zod": "^3.24.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@eslint/eslintrc": "^3.2.0",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~18.3.12",
    "eslint": "^9.17.0",
    "eslint-config-expo": "~8.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.0",
    "openapi-typescript": "^7.4.4",
    "prettier": "^3.4.2",
    "typescript": "~5.7.2"
  }
}
