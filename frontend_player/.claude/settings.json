{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "worktree": { "baseRef": "head" },
  "permissions": {
    "allow": [
      "Bash(pnpm install:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm check:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm doctor:*)",
      "Bash(pnpm gen:api:*)",
      "Bash(npx expo-doctor:*)",
      "Bash(npx expo install --check)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p8)",
      "Read(./**/*.jks)",
      "Read(./node_modules/**)",
      "Read(./.expo/**)",
      "Read(./android/**)",
      "Read(./ios/**)"
    ],
    "additionalDirectories": [".."]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/../.claude/hooks/enforce-ownership.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/../.claude/hooks/guard-bash.sh"
          }
        ]
      }
    ]
  }
}
