# Expo and React Native assume a flat node_modules. pnpm's default symlinked layout puts
# every package behind `.pnpm/<name>@<version>/node_modules/<name>`, which breaks the
# `node_modules/(?!…)` allowlists that Metro and jest-expo use to decide what still needs
# transforming — React Native ships untranspiled Flow, so the first thing that fails is
# `jest` parsing `error-guard.js`.
#
# Hoisted linking is Expo's documented answer for pnpm. It is a build-tool setting, not an
# architectural one: this app still owns its own node_modules and shares no workspace
# packages with frontend_club (ADR-0005).
node-linker=hoisted
