{
  "expo": {
    "name": "Rakieta",
    "slug": "rakieta-player",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "rakieta",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rakieta.player"
    },
    "android": {
      "package": "com.rakieta.player",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "//": "Non-secret config surfaced via expo-constants. Anything in the shipped bundle is PUBLIC — never put a secret here. See CLAUDE.md Safety.",
      "apiUrl": "http://localhost:8000"
    }
  }
}
