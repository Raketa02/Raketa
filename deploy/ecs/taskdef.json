{
  "family": "basebackend-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::__AWS_ACCOUNT_ID__:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::__AWS_ACCOUNT_ID__:role/basebackend-task-role",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "api",
      "image": "__IMAGE__",
      "essential": true,
      "portMappings": [
        { "containerPort": 8000, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "ENV", "value": "prod" },
        { "name": "APP_HOST", "value": "0.0.0.0" },
        { "name": "APP_PORT", "value": "8000" },
        { "name": "LOG_LEVEL", "value": "INFO" },
        { "name": "LOG_JSON", "value": "true" },
        { "name": "DB_SSL_MODE", "value": "verify-full" },
        { "name": "DB_SSL_ROOT_CERT_PATH", "value": "/etc/ssl/rds/rds-global-bundle.pem" },
        { "name": "JWT_ALGORITHM", "value": "HS256" },
        { "name": "ACCESS_TOKEN_EXPIRE_SECONDS", "value": "900" },
        { "name": "REFRESH_TOKEN_EXPIRE_SECONDS", "value": "86400" }
      ],
      "secrets": [
        { "name": "JWT_SECRET_KEY", "valueFrom": "arn:aws:secretsmanager:__AWS_REGION__:__AWS_ACCOUNT_ID__:secret:basebackend/prod:JWT_SECRET_KEY::" },
        { "name": "WRITER_DB_URL", "valueFrom": "arn:aws:secretsmanager:__AWS_REGION__:__AWS_ACCOUNT_ID__:secret:basebackend/prod:WRITER_DB_URL::" },
        { "name": "READER_DB_URL", "valueFrom": "arn:aws:secretsmanager:__AWS_REGION__:__AWS_ACCOUNT_ID__:secret:basebackend/prod:READER_DB_URL::" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -fsS http://127.0.0.1:8000/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 20
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/basebackend",
          "awslogs-region": "__AWS_REGION__",
          "awslogs-stream-prefix": "api",
          "awslogs-create-group": "true"
        }
      },
      "readonlyRootFilesystem": false,
      "linuxParameters": {
        "initProcessEnabled": true
      }
    }
  ]
}
